# Copy to .env (gitignored). This is ONLY needed to OPTIONALLY regenerate the
# fingerprints with your own model. The fingerprints are already bundled under
# data/, so the default `python reproduce.py` needs NO .env, NO key, and NO model.
#
# Local distillers via ollama (no key needed), e.g. qwen2.5 / qwen3:14b:
OLLAMA_HOST=http://localhost:11434
# Hosted distillers (Anthropic API). Leave BLANK to skip. NOTE: the paper's
# Haiku/Opus skeletons were produced by Claude Code agents, not the API, so the
# bundled fingerprints are the authoritative ones; re-distillation reproduces the
# METHOD with whatever model you pick, not those exact skeletons.
ANTHROPIC_API_KEY=
